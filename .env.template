# Omni-Channel Bot Configuration Template

# --- Database (Supabase) ---
SUPABASE_URL="your_supabase_project_url"
SUPABASE_KEY="your_supabase_anon_key"

# --- AI: News Agent + everything else (Multi-Key Support) ---
# Separate multiple keys with commas
OPENROUTER_API_KEYS="key1,key2,key3"

# --- AI: Article Agent (its own provider / key / model) ---
# Leave blank to share the keys above. Set these to run the blog writer on a
# stronger or paid model without affecting the news agent.
ARTICLE_API_KEYS=""
ARTICLE_API_PROVIDER="openrouter"   # openrouter | groq | openai
ARTICLE_API_BASE=""                 # optional explicit endpoint override
ARTICLE_MODEL=""                    # e.g. llama-3.3-70b-versatile (Groq)
CHANNEL_USERNAME="" # Leave blank for now, e.g., @DailyPulsePK

# --- X (Twitter) API v2 (Free Tier) ---
X_API_KEY="your_x_api_key"
X_API_SECRET="your_x_api_secret"
X_ACCESS_TOKEN="your_x_access_token"
X_ACCESS_SECRET="your_x_access_secret"

# --- Reddit API (PRAW) ---
REDDIT_CLIENT_ID="your_reddit_client_id"
REDDIT_CLIENT_SECRET="your_reddit_client_secret"
REDDIT_USERNAME="your_reddit_username"
REDDIT_PASSWORD="your_reddit_password"
REDDIT_USER_AGENT="windows:omni.channel.bot:v1.0 (by u/yourusername)"

# --- Telegram Broadcaster (main account -> news channel) ---
TELEGRAM_API_ID="your_telegram_api_id"
TELEGRAM_API_HASH="your_telegram_api_hash"
TELEGRAM_PHONE="your_phone_number"
# Required in production (Render): sessions/ is not persisted, so file-based
# logins are lost on every deploy. Generate with telegram_login.py.
TELEGRAM_SESSION_STRING=""
ADMIN_USER_ID="your_telegram_user_id" # To receive alerts

# --- Stealth Marketer (BURNER account — never your personal number) ---
STEALTH_PHONE=""
STEALTH_SESSION_STRING=""
TARGET_STEALTH_GROUPS="" # Comma-separated PUBLIC group usernames, e.g. @group1,@group2
# Group people are invited to. For a supergroup this must include the -100
# prefix, e.g. -1005533411583. A plain -5533411583 will NOT resolve.
STEALTH_INVITE_GROUP=""

# --- Signal Copier (Whale Tracker VIP) ---
# Channels to watch for crypto signals (comma-separated)
SOURCE_SIGNAL_CHANNELS=""
# Group the cleansed signals get posted into. Same -100 rule as above.
SIGNAL_TARGET_GROUP=""

# --- The Brain (Goals) ---
WEEKLY_SUBSCRIBER_GOAL=100
MAX_DAILY_REDDIT_POSTS=2
MAX_DAILY_X_POSTS=5
MAX_DAILY_TELEGRAM_REPLIES=8

# --- Notifications (Email) ---
# Resend is STRONGLY preferred in production: Render's free tier blocks
# outbound SMTP ports, so Gmail SMTP silently fails there. Resend uses HTTPS.
RESEND_API_KEY=""
# Gmail SMTP fallback (works locally). Requires a Gmail App Password.
EMAIL_SENDER=""
EMAIL_APP_PASSWORD=""
EMAIL_RECEIVER="" # Leave blank to send to sender

# --- Deployment (Render) ---
# Your public service URL. Without this the keep-alive pings localhost, which
# does NOT stop Render from idling the instance — the usual cause of the bot
# "randomly not working".
RENDER_EXTERNAL_URL=""

# --- Image generation (optional) ---
BING_COOKIE=""
